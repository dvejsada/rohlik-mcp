# Rohlik MCP server configuration.
# Copy this file to `.env`:
#   cp .env.example .env

# NOTE: there are no credential variables here. Shop logins are supplied per
# request by each client, as the X-Rohlik-Username / X-Rohlik-Password headers
# (plus an optional X-Rohlik-Site header choosing the shop), so one server can
# serve several accounts.

# --- Recommended ---
# Require clients to authenticate with this bearer token. When unset, anything
# that can reach the endpoint can drive the tools with credentials of its own
# choosing. Use a long random string; clients send it as:
#   Authorization: Bearer <token>
#ROHLIK_MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Optional (defaults shown) ---
# Default shop when a request has no X-Rohlik-Site header:
#   cz (Rohlik.cz), de (Knuspr.de), at (Gurkerl.at), hu (Kifli.hu), ro (Sezamo.ro)
#ROHLIK_SITE=cz
# Advanced: send every request to this URL (e.g. a proxy) instead of the shop's
# own. The server then serves only its ROHLIK_SITE shop. A shop's own address
# (e.g. https://www.knuspr.de) just selects that shop, like ROHLIK_SITE.
#ROHLIK_BASE_URL=
# Request timeout, in seconds
#ROHLIK_TIMEOUT=30
# HTTP bind host
#ROHLIK_MCP_HOST=0.0.0.0
# HTTP bind port
#ROHLIK_MCP_PORT=8000
# HTTP endpoint path
#ROHLIK_MCP_PATH=/mcp/
# Seconds an unused account session is kept before being logged out (min 60)
#ROHLIK_CLIENT_TTL=900
# Most account sessions held at once (least recently used dropped first)
#ROHLIK_MAX_CLIENTS=50
